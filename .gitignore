# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and editor/OS files
.venv/
venv/
env/
.DS_Store
WHATHAPPENING.md

# Generated logs
*.log

# Generated replays and experiment outputs; keep directory placeholders.
replays/*
!replays/.gitkeep
!replays/kaggle_replays/
replays/kaggle_replays/*
!replays/kaggle_replays/.gitkeep
!replays/kaggle_replays/README.md
references/kaggle_agents/*
!references/kaggle_agents/.gitkeep
!references/kaggle_agents/README.md
experiments/results/*
!experiments/results/.gitkeep
